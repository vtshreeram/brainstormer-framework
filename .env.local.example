# ─────────────────────────────────────────────────────────────
#  Brainstormer – Environment Variables
#  Copy this file to .env.local and fill in your values.
#  Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# OpenAI API Key
# Used for document generation, section improvement, and regeneration.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# OpenAI Model (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# ─────────────────────────────────────────────────────────────
# Database Configuration (Neon PostgreSQL)
# Get your connection string from: https://neon.tech/dashboard
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DB_HOST=ep-blue-art-a1ym0ofn-pooler.ap-southeast-1.aws.neon.tech
NEXT_PUBLIC_DB_PORT=5432
NEXT_PUBLIC_DB_USER=neondb_owner
NEXT_PUBLIC_DB_PASSWORD=npg_...your-password-here...
NEXT_PUBLIC_DB_NAME=neondb